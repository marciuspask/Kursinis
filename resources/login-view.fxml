<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="valdikliai.LoginController">
    <padding>
        <Insets top="30.0" right="40.0" bottom="30.0" left="40.0" />
    </padding>
    <children>
        <Label text="Prisijungimas" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        <TextField fx:id="elPastasField" promptText="El. paštas" />
        <PasswordField fx:id="slaptazodisField" promptText="Slaptažodis" />
        <Button text="Prisijungti" onAction="#prisijungti" defaultButton="true" prefWidth="250.0" />
        <Label fx:id="klaidosLabel" style="-fx-text-fill: red;" />
    </children>
</VBox>