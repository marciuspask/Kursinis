<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="valdikliai.MainController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>
    <children>
        <Label text="Augintinių priežiūros sistema" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
        <Label fx:id="vartotojoLabel" />

        <Button fx:id="imonesBtn" text="Įmonės registracija" onAction="#atidarytiImonesReg" prefWidth="250.0" />
        <Button fx:id="vadovoBtn" text="Vadovo registracija" onAction="#atidarytiVadovoReg" prefWidth="250.0" />
        <Button fx:id="savininkoBtn" text="Savininko registracija" onAction="#atidarytiSavininkoReg" prefWidth="250.0" />
        <Button fx:id="augintinioBtn" text="Augintinio registracija" onAction="#atidarytiAugintinioReg" prefWidth="250.0" />
        <Button fx:id="priziuretojoBtn" text="Prižiūrėtojo registracija" onAction="#atidarytiPriziuretojoReg" prefWidth="250.0" />

        <Button text="Atsijungti" onAction="#atsijungti" prefWidth="250.0" />
    </children>
</VBox>